# ---------------------------------------------------------------------------
# Configuracion de la aplicacion
# ---------------------------------------------------------------------------
APP_NAME="API Eventos ESPOL"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Base de datos - Supabase (PostgreSQL)
# Supabase Dashboard -> Project Settings -> Database -> Connection string
#
# Usa el "Session pooler" (puerto 5432) o el "Transaction pooler" (puerto 6543).
# El usuario del pooler tiene el formato: postgres.<project-ref>
# ---------------------------------------------------------------------------
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=tu_password_de_supabase
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# CORS - origenes permitidos para el frontend React (separados por coma)
# Usa * solo en desarrollo.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
