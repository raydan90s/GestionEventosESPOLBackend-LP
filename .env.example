# ---------------------------------------------------------------------------
# Configuracion de la aplicacion
# ---------------------------------------------------------------------------
APP_NAME="API Eventos ESPOL"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Imprime una linea por peticion (metodo, ruta, estado, duracion y cuerpo) en la
# terminal donde corre el servidor. Si se omite, sigue a APP_DEBUG.
# Dejalo apagado fuera de desarrollo: el cuerpo de una inscripcion lleva el
# correo y el telefono del estudiante.
LOG_REQUESTS=true

# ---------------------------------------------------------------------------
# Base de datos - Supabase (PostgreSQL)
# Supabase Dashboard -> Project Settings -> Database -> Connection string
#
# Usa el "Session pooler" (puerto 5432) o el "Transaction pooler" (puerto 6543).
# El usuario del pooler tiene el formato: postgres.<project-ref>
# ---------------------------------------------------------------------------
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=tu_password_de_supabase
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# CORS - origenes permitidos para el frontend React (separados por coma)
# Usa * solo en desarrollo.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
